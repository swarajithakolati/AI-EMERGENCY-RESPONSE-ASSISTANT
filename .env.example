# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database URL (Default SQLite file; can be PostgreSQL e.g. postgresql://user:pass@localhost:5432/emergency_db)
DATABASE_URL=sqlite:///./emergency_response.db

# Optional AI / LLM APIs (Built-in robust local NLP fallback ensures 100% functionality without API keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash
